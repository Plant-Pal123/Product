DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/mango
SECRET_KEY=change-me
SOIL_DATA_API_BASE=
WEATHER_DATA_API_BASE=
SATELLITE_DATA_API_BASE=

# Free web service key from https://lris.scinfo.org.nz/ (My Account > API keys),
# required for soil property enrichment (see backend/README.md). Leave blank to
# run the ingestion pipeline in dry-run mode only.
LRIS_API_KEY=

# S-map soil layers (drainage, texture, depth class) are CC BY-NC-ND and
# pending a licence decision - see backend/README.md. Leave false until that's
# decided; FSL soil data works either way. Also set SMAP_ENABLED in
# frontend/js/config.js to match.
SMAP_ENABLED=false

# Free OAuth client from https://dataspace.copernicus.eu/ (Dashboard > User
# Settings > OAuth clients), required for satellite/NDVI enrichment (see
# backend/README.md). Leave blank to run the ingestion pipeline in dry-run
# mode only.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# API key from https://platform.deepseek.com/ (API keys page), used to add a
# plain-language summary, agronomic notes and finance commentary to the future
# plan PDF (see backend/README.md). Leave blank to skip that section - the PDF
# still renders with the heuristic data only.
DEEPSEEK_API_KEY=
